# ==============================================================================
# PASO 2: EXCEPCIONES PERSONALIZADAS
# ==============================================================================
# Definimos jerarquías de excepciones propias para controlar fallos específicos
# de clientes, servicios y reservas de forma profesional.
class ErrorCliente(Exception):
    """Excepción lanzada cuando los datos de un cliente son inválidos o duplicados."""
    pass


class ErrorServicio(Exception):
    """Excepción lanzada cuando un servicio tiene parámetros erróneos o no está disponible."""
    pass


class ErrorReserva(Exception):
    """Excepción lanzada cuando ocurre un fallo al procesar o cancelar una reserva."""
    pass


# ==============================================================================
# PASO 3: CLASES ABSTRACTAS BASE (Abstracción)
# ==============================================================================
class EntidadSistema(ABC):
    """Clase abstracta general que representa cualquier entidad del sistema Software FJ."""
    
    @abstractmethod
    def obtener_info(self) -> str:
        """Método abstracto obligatorio para describir la entidad."""
        pass


class Servicio(EntidadSistema):
    """Clase abstracta base para los servicios ofrecidos por Software FJ."""
    
    def __init__(self, codigo: str, nombre: str, tarifa_base: float):
        self.codigo = codigo
        self.nombre = nombre
        self.tarifa_base = tarifa_base  # Invoca al setter para validar que sea > 0
        self.disponible = True

    @property
    def tarifa_base(self) -> float:
        return self.__tarifa_base

    @tarifa_base.setter
    def tarifa_base(self, valor: float):
        # Validación estricta: no se permiten tarifas negativas ni iguales a cero
        if valor <= 0:
            logging.error(f"Tarifa inválida ({valor}) al intentar crear el servicio '{self.nombre}'.")
            raise ErrorServicio("La tarifa base del servicio debe ser mayor a cero.")
        self.__tarifa_base = valor

    @abstractmethod
    def calcular_costo(self, duracion: int, descuento: float = 0.0, incluir_iva: bool = True) -> float:
        """
        Método polimórfico y sobrecargado (mediante parámetros opcionales de descuento e IVA)
        que cada servicio especializado debe sobrescribir.
        """
        pass

    @abstractmethod
    def validar_parametros(self, duracion: int):
        """Valida las reglas de negocio específicas de cada tipo de servicio."""
        pass

    def obtener_info(self) -> str:
        estado = "Disponible" if self.disponible else "No disponible"
        return f"[{self.codigo}] {self.nombre} - Tarifa base: ${self.tarifa_base:,.2f} ({estado})"


# ==============================================================================
# PASO 4: CLASE CLIENTE (Encapsulación y Validaciones)
# ==============================================================================
class Cliente(EntidadSistema):
    """Representa a un cliente de Software FJ con atributos privados y validados."""
    
    def __init__(self, nombre: str, documento: str, correo: str):
        self.nombre = nombre        # Valida mediante @nombre.setter
        self.documento = documento  # Valida mediante @documento.setter
        self.correo = correo        # Valida mediante @correo.setter

    @property
    def nombre(self) -> str:
        return self.__nombre

    @nombre.setter
    def nombre(self, valor: str):
        if not valor or not valor.strip():
            logging.error(f"Registro fallido: nombre vacío ('{valor}').")
            raise ErrorCliente("El nombre del cliente no puede estar vacío.")
        self.__nombre = valor.strip()

    @property
    def documento(self) -> str:
        return self.__documento

    @documento.setter
    def documento(self, valor: str):
        if not valor or not valor.strip() or not valor.isdigit():
            logging.error(f"Registro fallido: documento no numérico o vacío ('{valor}').")
            raise ErrorCliente("El documento del cliente debe contener solo números y no estar vacío.")
        self.__documento = valor.strip()

    @property
    def correo(self) -> str:
        return self.__correo

    @correo.setter
    def correo(self, valor: str):
        if not valor or "@" not in valor or "." not in valor:
            logging.error(f"Registro fallido: formato de correo inválido ('{valor}').")
            raise ErrorCliente("El correo electrónico ingresado no es válido.")
        self.__correo = valor.strip()

    def obtener_info(self) -> str:
        return f"Cliente: {self.__nombre} | Documento: {self.__documento} | Correo: {self.__correo}"


# ==============================================================================
# PASO 5: SERVICIOS ESPECIALIZADOS (Herencia y Polimorfismo)
# ==============================================================================
class ReservaSala(Servicio):
    """Servicio especializado para el alquiler de salas por horas."""
    
    def __init__(self, codigo: str, nombre: str, tarifa_base: float, capacidad: int):
        super().__init__(codigo, nombre, tarifa_base)
        if capacidad <= 0:
            raise ErrorServicio("La capacidad de la sala debe ser mayor a 0 personas.")
        self.capacidad = capacidad

    def validar_parametros(self, duracion: int):
        if duracion < 1 or duracion > 12:
            raise ErrorServicio("La reserva de salas debe ser entre 1 y 12 horas.")

    def calcular_costo(self, duracion: int, descuento: float = 0.0, incluir_iva: bool = True) -> float:
        self.validar_parametros(duracion)
        subtotal = self.tarifa_base * duracion
        subtotal -= subtotal * descuento
        return subtotal * 1.19 if incluir_iva else subtotal


class AlquilerEquipo(Servicio):
    """Servicio especializado para el alquiler de equipos tecnológicos por días."""
    
    def __init__(self, codigo: str, nombre: str, tarifa_base: float, cantidad_disponible: int):
        super().__init__(codigo, nombre, tarifa_base)
        if cantidad_disponible < 0:
            raise ErrorServicio("La cantidad de equipos disponibles no puede ser negativa.")
        self.cantidad_disponible = cantidad_disponible
        self.disponible = cantidad_disponible > 0

    def validar_parametros(self, duracion: int):
        if not self.disponible or self.cantidad_disponible <= 0:
            raise ErrorServicio(f"No hay unidades disponibles para el equipo '{self.nombre}'.")
        if duracion < 1:
            raise ErrorServicio("El alquiler de equipos requiere mínimo 1 día.")

    def calcular_costo(self, duracion: int, descuento: float = 0.0, incluir_iva: bool = True) -> float:
        self.validar_parametros(duracion)
        # Incluye un cargo fijo de $15,000 por concepto de seguro de equipo
        subtotal = (self.tarifa_base * duracion) + 15000
        subtotal -= subtotal * descuento
        return subtotal * 1.19 if incluir_iva else subtotal


class AsesoriaEspecializada(Servicio):
    """Servicio especializado para consultorías técnicas por horas."""
    
    def __init__(self, codigo: str, nombre: str, tarifa_base: float, especialidad: str):
        super().__init__(codigo, nombre, tarifa_base)
        if not especialidad or not especialidad.strip():
            raise ErrorServicio("Debe especificar el área de la asesoría.")
        self.especialidad = especialidad

    def validar_parametros(self, duracion: int):
        if duracion < 1 or duracion > 8:
            raise ErrorServicio("Las asesorías especializadas se agendan entre 1 y 8 horas.")

    def calcular_costo(self, duracion: int, descuento: float = 0.0, incluir_iva: bool = True) -> float:
        self.validar_parametros(duracion)
        subtotal = self.tarifa_base * duracion
        # Descuento automático del 10% si la asesoría supera las 4 horas
        if duracion > 4:
            subtotal *= 0.90
        subtotal -= subtotal * descuento
        return subtotal * 1.19 if incluir_iva else subtotal


