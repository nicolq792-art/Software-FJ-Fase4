# PASO 6: CLASE RESERVA Y GESTOR DEL SISTEMA (Excepciones avanzadas y listas)
# ==============================================================================
class Reserva(EntidadSistema):
    """Integra Cliente, Servicio, duración y estado con manejo avanzado de excepciones."""
    
    def __init__(self, id_reserva: str, cliente: Cliente, servicio: Servicio, duracion: int):
        if not isinstance(cliente, Cliente):
            raise ErrorReserva("Se requiere una instancia válida de Cliente para reservar.")
        if not isinstance(servicio, Servicio):
            raise ErrorReserva("Se requiere una instancia válida de Servicio para reservar.")
            
        self.id_reserva = id_reserva
        self.cliente = cliente
        self.servicio = servicio
        self.duracion = duracion
        self.estado = "PENDIENTE"
        self.costo_total = 0.0

    def procesar_y_confirmar(self, descuento: float = 0.0, incluir_iva: bool = True):
        """Implementa try/except/else/finally y encadenamiento de excepciones."""
        try:
            if not self.servicio.disponible:
                raise ErrorServicio(f"El servicio '{self.servicio.nombre}' no está disponible.")
            
            # Llamada polimórfica al cálculo de costo según el tipo de servicio
            self.costo_total = self.servicio.calcular_costo(self.duracion, descuento, incluir_iva)
            
        except ErrorServicio as e:
            # Encadenamiento de excepciones (raise ... from e)
            self.estado = "FALLIDA"
            logging.error(f"[Reserva {self.id_reserva}] Fallo en servicio: {e}")
            raise ErrorReserva(f"No se pudo completar la reserva {self.id_reserva}.") from e
            
        except Exception as e:
            self.estado = "FALLIDA"
            logging.critical(f"[Reserva {self.id_reserva}] Error inesperado: {e}")
            raise ErrorReserva(f"Error crítico procesando la reserva {self.id_reserva}.") from e
            
        else:
            # Solo se ejecuta si el bloque try finalizó sin excepciones
            self.estado = "CONFIRMADA"
            if isinstance(self.servicio, AlquilerEquipo):
                self.servicio.cantidad_disponible -= 1
                if self.servicio.cantidad_disponible == 0:
                    self.servicio.disponible = False
            logging.info(f"[Reserva {self.id_reserva}] CONFIRMADA para {self.cliente.nombre}. Total: ${self.costo_total:,.2f}")
            
        finally:
            # Siempre se ejecuta para dejar trazabilidad en el archivo de logs
            logging.info(f"[Auditoría {self.id_reserva}] Proceso terminado. Estado final: {self.estado}")

    def cancelar_reserva(self):
        """Cancela una reserva activa y restablece el inventario si aplica."""
        try:
            if self.estado == "CANCELADA":
                raise ErrorReserva(f"La reserva {self.id_reserva} ya estaba cancelada.")
            if self.estado == "FALLIDA":
                raise ErrorReserva(f"No se puede cancelar la reserva {self.id_reserva} porque falló.")
                
            if self.estado == "CONFIRMADA" and isinstance(self.servicio, AlquilerEquipo):
                self.servicio.cantidad_disponible += 1
                self.servicio.disponible = True
                
            self.estado = "CANCELADA"
            logging.info(f"[Reserva {self.id_reserva}] Cancelada exitosamente.")
        except ErrorReserva as e:
            logging.warning(f"[Cancelación inválida] {e}")
            raise

    def obtener_info(self) -> str:
        return (f"Reserva #{self.id_reserva} | Estado: {self.estado} | "
                f"Cliente: {self.cliente.nombre} | Servicio: {self.servicio.nombre} | "
                f"Duración: {self.duracion} | Total: ${self.costo_total:,.2f}")


class SistemaSoftwareFJ:
    """Administra las listas internas en memoria sin utilizar bases de datos."""
    
    def __init__(self):
        self.clientes = []
        self.servicios = []
        self.reservas = []

    def registrar_cliente(self, nombre: str, documento: str, correo: str):
        try:
            nuevo_cliente = Cliente(nombre, documento, correo)
            for c in self.clientes:
                if c.documento == documento:
                    raise ErrorCliente(f"El documento {documento} ya está registrado.")
            self.clientes.append(nuevo_cliente)
            logging.info(f"Cliente registrado: {nombre} ({documento})")
            print(f"✅ Cliente registrado: {nuevo_cliente.nombre}")
            return nuevo_cliente
        except ErrorCliente as e:
            logging.error(f"Error registrando cliente: {e}")
            print(f"❌ Error de Cliente: {e}")
            return None

    def agregar_servicio(self, servicio: Servicio):
        try:
            if not isinstance(servicio, Servicio):
                raise ErrorServicio("El objeto no corresponde a un Servicio válido.")
            self.servicios.append(servicio)
            logging.info(f"Servicio agregado: {servicio.nombre}")
            print(f"✅ Servicio agregado: {servicio.nombre}")
        except ErrorServicio as e:
            logging.error(f"Error agregando servicio: {e}")
            print(f"❌ Error de Servicio: {e}")

    def crear_reserva(self, id_reserva: str, cliente: Cliente, servicio: Servicio, duracion: int, descuento: float = 0.0):
        try:
            nueva_reserva = Reserva(id_reserva, cliente, servicio, duracion)
            nueva_reserva.procesar_y_confirmar(descuento=descuento)
            self.reservas.append(nueva_reserva)
            print(f"✅ {nueva_reserva.obtener_info()}")
            return nueva_reserva
        except ErrorReserva as e:
            print(f"❌ Error en Reserva #{id_reserva}: {e}")
            if e.__cause__:
                print(f"   ↳ Causa raíz registrada en log: {e.__cause__}")
            return None


